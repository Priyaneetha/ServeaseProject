<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-100 min-h-screen">

  <!-- NAVBAR -->
  <%- include("partials/navbar", { user: user }) %>


  <div class="p-10">

    <h2 class="text-3xl font-bold mb-8">Pending Provider Approvals</h2>

    <% if (providers.length === 0) { %>
      <p class="text-gray-400">No pending providers.</p>
    <% } %>

    <div class="grid md:grid-cols-2 gap-6">
      <% providers.forEach(p => { %>
        <div class="bg-gray-800 p-6 rounded border border-gray-700">
          <h3 class="text-xl font-bold mb-2"><%= p.name %></h3>
          <p><strong>Service:</strong> <%= p.service %></p>
          <p><strong>Location:</strong> <%= p.location %></p>
          <p><strong>Phone:</strong> <%= p.phone %></p>

          <form method="POST" action="/approve/<%= p.id %>" class="mt-4">
            <button class="bg-green-600 px-4 py-2 rounded hover:bg-green-500">
              Approve
            </button>
          </form>
        </div>
      <% }) %>
    </div>

  </div>

  <footer class="bg-gray-800 text-gray-400 text-center p-4 mt-16 border-t border-gray-700">
    © 2026 ServEase 
  </footer>

</body>
</html>