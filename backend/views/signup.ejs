<!DOCTYPE html>
<html>
<head>
  <title>Signup - ServEaseS</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-white flex items-center justify-center min-h-screen">

  <div class="bg-gray-800 p-10 rounded-xl w-full max-w-md shadow-lg border border-gray-700">

    <h2 class="text-2xl font-bold mb-6 text-center">Create Account</h2>

    <!-- IMPORTANT: method + action added -->
    <form method="POST" action="/register" class="space-y-4">

      <input 
        type="email"
        name="email"
        placeholder="Email"
        required
        class="w-full p-3 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >

      <input 
        type="password"
        name="password"
        placeholder="Password"
        required
        class="w-full p-3 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >

      <!-- DO NOT allow admin signup publicly -->
      <select 
        name="role"
        required
        class="w-full p-3 rounded bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="">Select Role</option>
        <option value="user">User</option>
        <option value="provider">Service Provider</option>
      </select>

      <button 
        type="submit"
        class="w-full bg-blue-600 py-3 rounded hover:bg-blue-500 transition"
      >
        Signup
      </button>

    </form>

    <p class="mt-4 text-sm text-gray-400 text-center">
      Already have an account?
      <a href="/login" class="text-blue-400 hover:underline">Login</a>
    </p>

  </div>

</body>
</html>