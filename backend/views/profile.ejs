<!DOCTYPE html>
<html>
<head>
  <title>Provider Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-white p-10">

  <!-- NAVBAR -->
  <%- include("partials/navbar", { user: user }) %>


  <!-- PROFILE CARD -->
  <div class="max-w-2xl mx-auto bg-gray-800 p-8 rounded-lg shadow-lg border border-gray-700">

    <h2 class="text-3xl font-bold mb-6 text-blue-400">
      <%= provider.name %>
    </h2>

    <div class="space-y-4 text-gray-300">

      <p>
        <span class="font-semibold text-white">Service:</span>
        <%= provider.service %>
      </p>

      <p>
        <span class="font-semibold text-white">Location:</span>
        <%= provider.location %>
      </p>

      <p>
        <span class="font-semibold text-white">Phone:</span>
        <%= provider.phone %>
      </p>

      <% if (provider.description) { %>
        <p>
          <span class="font-semibold text-white">Description:</span>
          <%= provider.description %>
        </p>
      <% } %>

      <p>
        <span class="font-semibold text-white">Status:</span>
        <span class="<%= provider.status === 'approved' ? 'text-green-400' : 'text-yellow-400' %> font-semibold">
          <%= provider.status %>
        </span>
      </p>

    </div>

  </div>

</body>
</html>