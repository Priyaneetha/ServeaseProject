<!DOCTYPE html>
<html>
<head>
  <title>ServEase</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-100">

<!-- NAVBAR -->
<%- include("partials/navbar", { user: user }) %>


<!-- HERO SECTION -->
<section class="text-center py-20 px-6">
  <h2 class="text-5xl font-extrabold mb-6">
    Find Trusted Local Services Instantly
  </h2>
  <p class="text-gray-400 max-w-2xl mx-auto mb-8">
    Connecting customers with professionals in seconds.
  </p>

  <div class="flex justify-center gap-4">
    <a href="/services"
       class="bg-blue-600 hover:bg-blue-500 px-6 py-3 rounded text-white transition">
      Get Started
    </a>
    <a href="#features"
       class="border border-gray-600 px-6 py-3 rounded hover:border-blue-400 transition">
      Learn More
    </a>
  </div>
</section>


<!-- PROBLEM & SOLUTION -->
<section class="py-24 px-6 bg-gray-800">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">

    <div class="bg-gray-900 p-10 rounded-lg border border-red-900/40">
      <h3 class="text-3xl font-bold mb-6 text-red-400">The Problem</h3>
      <p class="text-gray-400 leading-relaxed">
        Finding reliable local service providers is chaotic and risky.
        There is no unified platform to verify credibility, compare options,
        or ensure service availability.
      </p>
    </div>

    <div class="bg-gray-900 p-10 rounded-lg border border-blue-900/40">
      <h3 class="text-3xl font-bold mb-6 text-blue-400">Our Solution</h3>
      <p class="text-gray-400 leading-relaxed">
        ServEase centralizes trusted local professionals into one smart platform.
        Users can search by service and location and connect instantly.
      </p>
    </div>

  </div>
</section>


<!-- FEATURES -->
<section id="features" class="py-20 px-6 bg-gray-800">
  <h3 class="text-3xl font-bold text-center mb-12">Key Features</h3>

  <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">

    <div class="bg-gray-900 p-6 rounded border border-gray-700 hover:border-blue-400 transition">
      <h4 class="text-xl font-bold mb-3 text-blue-400">Smart Search</h4>
      <p class="text-gray-400">Search services instantly by name and location.</p>
    </div>

    <div class="bg-gray-900 p-6 rounded border border-gray-700 hover:border-blue-400 transition">
      <h4 class="text-xl font-bold mb-3 text-blue-400">Role-Based Access</h4>
      <p class="text-gray-400">Separate dashboards for customers and providers</p>
    </div>

    <div class="bg-gray-900 p-6 rounded border border-gray-700 hover:border-blue-400 transition">
      <h4 class="text-xl font-bold mb-3 text-blue-400">Admin Verification</h4>
      <p class="text-gray-400">All providers are approved before appearing publicly.</p>
    </div>

  </div>
</section>


<!-- HOW IT WORKS -->
<section class="py-20 px-6 text-center">
  <h3 class="text-3xl font-bold mb-10">How It Works</h3>

  <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
    <div>
      <div class="text-4xl font-bold text-blue-400 mb-4">1</div>
      <p class="text-gray-400">Search for a service in your location.</p>
    </div>

    <div>
      <div class="text-4xl font-bold text-blue-400 mb-4">2</div>
      <p class="text-gray-400">Browse verified providers.</p>
    </div>

    <div>
      <div class="text-4xl font-bold text-blue-400 mb-4">3</div>
      <p class="text-gray-400">Contact directly and get the job done.</p>
    </div>
  </div>
</section>


<!-- CTA -->
<section class="py-20 px-6 bg-blue-600 text-center">
  <h3 class="text-3xl font-bold mb-6 text-white">
    Ready to Experience Smarter Service Discovery?
  </h3>
  <a href="/services"
     class="bg-white text-blue-600 px-6 py-3 rounded font-bold hover:bg-gray-200 transition">
    Explore Services
  </a>
</section>


<footer class="bg-gray-800 text-gray-400 text-center p-4 border-t border-gray-700">
  © 2026 ServEase
</footer>

</body>
</html>