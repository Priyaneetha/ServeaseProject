<!DOCTYPE html>
<html>
<head>
  <title>Provider Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen p-10">

  <!-- NAVBAR -->
  <%- include("partials/navbar", { user: user }) %>

  <h2 class="text-2xl font-bold mb-6">Submit Your Service Details</h2>

  <form method="POST" action="/submit-provider" class="space-y-4 max-w-md">

  <input name="name" placeholder="Business Name"
    class="w-full bg-gray-800 p-3 rounded border border-gray-700" required>

  <input name="service" placeholder="Service Type"
    class="w-full bg-gray-800 p-3 rounded border border-gray-700" required>

  <input name="location" placeholder="Location"
    class="w-full bg-gray-800 p-3 rounded border border-gray-700" required>

  <input name="phone" placeholder="Phone"
    class="w-full bg-gray-800 p-3 rounded border border-gray-700" required>

  <textarea name="description" placeholder="Description"
    class="w-full bg-gray-800 p-3 rounded border border-gray-700"></textarea>

  <button type="submit"
    class="bg-blue-600 px-4 py-2 rounded">
    Submit for Approval
  </button>

</form>

  <h3 class="text-xl font-bold mt-10 mb-4">Your Submission Status</h3>
  <% if (!listings || listings.length === 0) { %>
    <p class="text-gray-400">You have not submitted any providers yet.</p>
  <% } else { %>
    <div class="grid md:grid-cols-2 gap-6">
      <% listings.forEach(p => { %>
        <div class="bg-gray-800 p-6 rounded border border-gray-700">
          <h3 class="text-xl font-bold mb-2"><%= p.name %></h3>
          <p><strong>Service:</strong> <%= p.service %></p>
          <p><strong>Status:</strong> <%= p.status %></p>
        </div>
      <% }); %>
    </div>
  <% } %>

  <footer class="bg-gray-800 text-gray-400 text-center p-4 mt-16 border-t border-gray-700">
    © 2026 ServEase
  </footer>

</body>
</html>